[Unit]
Description=Reverse Multi-Tor Proxy Cluster (10 Nodes)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/reverse-multi-tor
ExecStartPre=/bin/bash /opt/reverse-multi-tor/start_tor.sh
ExecStart=/usr/bin/python3 /opt/reverse-multi-tor/cluster.py --config /opt/reverse-multi-tor/config.json
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
